#!/bin/bash
# shotkit — App Store screenshot pipeline CLI
# Usage: shotkit <command> [options]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
VERSION="1.0.0"

usage() {
  cat <<EOF
shotkit $VERSION — App Store screenshot pipeline

Usage:
  shotkit <command> [options]

Commands:
  capture       Automated Simulator capture (boot, launch, deep link, screenshot)
  generate      Composite styled screenshots with text overlays
  validate      Check output against App Store Connect requirements
  install-deps  Install Python + Pillow dependencies

Examples:
  shotkit capture --bundle-id com.app.id --devices "iPhone 16 Pro Max" --deeplinks "myapp://home,myapp://detail"
  shotkit generate --app-name "MyApp" --captures ./raw --copy ./copy.json --template bold --devices iphone-6.9
  shotkit validate --dir ./screenshots-output

Run 'shotkit <command> --help' for command-specific options.
EOF
}

if [ $# -eq 0 ]; then
  usage
  exit 0
fi

COMMAND="$1"
shift

case "$COMMAND" in
  capture)
    exec bash "$SCRIPT_DIR/auto_capture.sh" "$@"
    ;;
  generate)
    exec python3 "$SCRIPT_DIR/generate_screenshots.py" "$@"
    ;;
  validate)
    exec python3 "$SCRIPT_DIR/validate_output.py" "$@"
    ;;
  install-deps)
    exec bash "$SCRIPT_DIR/install_deps.sh" "$@"
    ;;
  version|--version|-v)
    echo "shotkit $VERSION"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    echo "Error: unknown command '$COMMAND'"
    echo "Run 'shotkit --help' for usage."
    exit 1
    ;;
esac
